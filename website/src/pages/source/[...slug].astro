---
import { useTranslations } from "../../i18n/index";
import Layout from "../../layouts/Layout.astro";
import SourceDetailPage from "../../components/SourceDetailPage.astro";
import { getSources, getSourceDetail } from "../../lib/sources";

export function getStaticPaths() {
  const sources = getSources();
  return sources.map((s) => ({
    params: { slug: s.id },
    props: { id: s.id },
  }));
}

const { id } = Astro.props as { id: string };
const source = getSourceDetail(id)!;
const t = useTranslations("en");
---

<Layout
  title={t("seo.sourceTitle", { name: source.name })}
  description={t("seo.sourceDescription", { name: source.name, description: source.description })}
>
  <SourceDetailPage id={id} locale="en" />
</Layout>
