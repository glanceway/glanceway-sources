---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found — Glanceway" description="This page could not be found. Return to Glanceway or browse community sources." noindex singleLocale>
  <section class="mx-auto max-w-3xl px-6 py-28">
    <p class="text-sm text-gray-500">404</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-5 text-gray-500 dark:text-gray-400">This address does not match a page on Glanceway.</p>
    <div class="mt-8 flex flex-wrap gap-6 text-sm">
      <a href="/" class="font-medium underline underline-offset-4">Go to the homepage</a>
      <a href="/sources/" class="font-medium underline underline-offset-4">Browse sources</a>
    </div>
  </section>
</Layout>
